{
  "name": "@fibre-dev/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for fibre: sandboxes for agents that sleep with their memory and wake on the next call",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript spec/openapi.json -o src/generated/api.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "reference": "node scripts/reference.mjs"
  },
  "keywords": [
    "fibre",
    "sandbox",
    "sandboxes",
    "ai",
    "agents",
    "code execution",
    "browser"
  ],
  "author": "fibre",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.65.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
